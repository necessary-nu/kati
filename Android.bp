rust_defaults {
    name: "rkati_defaults",
    edition: "2024",
    lints: "android",
    clippy_lints: "android",
    rustlibs: [
        "libanyhow",
        "libbytes",
        "liblibc",
        "liblog_rust",
        "libmemchr",
        "libos_pipe",
        "libparking_lot",
    ],
}

rust_library_host {
    name: "libkati",
    crate_name: "kati",
    defaults: ["rkati_defaults"],
    srcs: ["src-rs/lib.rs"],
}

rust_binary_host {
    name: "rkati",
    defaults: ["rkati_defaults"],
    srcs: ["src-rs/main.rs"],
    // The allocator is the binary's, and so is the cargo feature that selects
    // it: the library must not carry jemalloc's bundled C sources for an
    // embedder that never installs a global allocator. This file already
    // scoped the dependency to the binary; `Cargo.toml` now agrees, with the
    // feature off by default, so the binary is where it gets asked for.
    features: ["jemalloc"],
    rustlibs: [
        "libkati",
    ],
    target: {
        linux: {
            rustlibs: [
                "libtikv_jemallocator",
            ],
        },
    },
}

rust_test_host {
    name: "rkati_unit_tests",
    defaults: ["rkati_defaults"],
    srcs: ["src-rs/lib.rs"],
}